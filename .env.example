# Copy this file to .env and fill in values.
# Never commit your real .env.

# Mock mode is enough for local smoke tests and portfolio demos without API cost.
LCA_MODEL_PROVIDER=mock

# Use OpenAI after you have an API key.
# LCA_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-key-here
# LCA_OPENAI_MODEL=gpt-4o-mini

# Free local LLM option if Ollama is installed and a model is pulled.
# LCA_MODEL_PROVIDER=ollama
# LCA_OLLAMA_BASE_URL=http://localhost:11434
# LCA_OLLAMA_MODEL=llama3.1:8b
# LCA_OLLAMA_TIMEOUT_SECONDS=90

LCA_CHROMA_DIR=.chroma
LCA_COLLECTION_NAME=lca_knowledge
LCA_KB_DIR=kb
LCA_RETRIEVER_BACKEND=lexical
LCA_EMBEDDING_MODEL=text-embedding-3-small
